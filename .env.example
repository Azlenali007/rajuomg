# Application Configuration
APP_NAME="OTP Doctor Verification"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.com

# Database Connection (MySQL 8+ with InnoDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=otp_platform
DB_USERNAME=otp_user
DB_PASSWORD=YourStrongDatabasePasswordHere

# External SMS Provider: OTP Doctor
# https://www.otpdoctor.in/stubs/handler_api.php
OTPDOCTOR_API_URL=https://www.otpdoctor.in/stubs/handler_api.php
OTPDOCTOR_API_KEY=YOUR_OTPDOCTOR_API_KEY_HERE

# Payment Gateways (Optional - Can also be configured via Super Admin Panel)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxx

MANUAL_QR_UPI_ID=pay@otpdoctor
MANUAL_QR_IMAGE=/assets/images/qr_placeholder.png

# WebSocket Port (if running persistent CLI server)
WS_PORT=8080
